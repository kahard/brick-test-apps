.venv/
**/__pycache__/
**/.pio/
**/managed_components/
**/assets/generated/
**/generated/
**/generated*.h
**/.pytest_cache/
**/sdkconfig*
!**/sdkconfig.defaults
**/CMakeLists.txt
**/CMakeListsPrivate.txt
.vscode/

# Panel 480x480 build descriptions are maintained project sources: they list
# the framework sources each application compiles.
!apps/esp32s3/panel_480x480/**/CMakeLists.txt

# JC1060 build descriptions are maintained project sources.
!apps/esp32p4/jc1060_7/**/CMakeLists.txt

# JC8012 build descriptions are maintained project sources.
!apps/esp32p4/jc8012_10/**/CMakeLists.txt

# CYD network test and benchmark demo build descriptions are maintained project sources.
!apps/esp32wroom32/cyd/common/network_*/CMakeLists.txt
!apps/esp32wroom32/cyd/common/network_*/src/CMakeLists.txt
!apps/esp32wroom32/cyd/common/display_benchmark_demo/CMakeLists.txt
!apps/esp32wroom32/cyd/common/display_benchmark_demo/src/CMakeLists.txt
!apps/esp32wroom32/cyd/common/audio_smoke/CMakeLists.txt
!apps/esp32wroom32/cyd/common/audio_smoke/src/CMakeLists.txt

# The ESP32-P4 co-processor update application.
!apps/esp32p4/common/**/CMakeLists.txt

# Wi-Fi credentials compiled into the network tests (tools/wifi_credentials.py).
/wifi-credentials.txt

# PC simulator build description and output.
!/pc/CMakeLists.txt
/build/
