CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESP32P4_REV_MIN_FULL=1
CONFIG_ESP32P4_REV_MAX_FULL=199
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# CONFIG_SPIRAM_USE_MALLOC is not set
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Optimize for speed (-O2): rendering, pixel copies and drivers run faster.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 1 ms FreeRTOS tick: delay_ms(1) sleeps 1 ms, not one 10 ms tick.
CONFIG_FREERTOS_HZ=1000
# 256 KB L2 cache with 128-byte lines: CPU work on PSRAM frame buffers runs
# about twice as fast (a 1024x600 fill: 16.9 -> 7.9 ms).
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
# Flash in QIO mode: four data lines read assets faster than DIO.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
